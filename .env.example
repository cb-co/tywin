NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemini-3.5-flash-lite
# /ask only. gemini-3.6-flash writes better SQL but its quota does not survive
# an interactive box; set it here when there is room for it.
GOOGLE_ASK_MODEL=gemini-3.5-flash-lite

# Runs the /ask box and the overview's "today's take" on OWNER_MODEL for one
# account — the signed-in user whose email matches. Leave unset and everyone,
# including you, stays on the models above.
OWNER_EMAIL=
OWNER_MODEL=gemini-3.7-flash
